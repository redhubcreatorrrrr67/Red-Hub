-- Load WindUI Library
local WindUI
do
	local response = nil
	local function makeFolderSafe(path)
		if makefolder and isfolder and not isfolder(path) then
			pcall(makefolder, path)
		end
	end

	if isfile and readfile and isfile("RedHubV1/windui.lua") then
		local ok, result = pcall(readfile, "RedHubV1/windui.lua")
		if ok and type(result) == "string" and #result > 100000 then
			response = result
		end
	end

	response = response or game:HttpGet("https://github.com/Footagesus/WindUI/releases/latest/download/main.lua")
	local chunk = loadstring(response)

	if writefile then
		pcall(function()
			makeFolderSafe("RedHubV1")
			writefile("RedHubV1/windui.lua", response)
		end)
	end

	WindUI = chunk()
end

