-- Role Helper Function
local function getPlayerRole(player)
	if not player.Character then return "Innocent" end
	for _, item in ipairs(player.Character:GetChildren()) do  
		if item:IsA("Tool") then  
			if item.Name == "Knife" then return "Murderer"  
			elseif item.Name == "Gun" or item.Name == "Revolver" then return "Sheriff" end  
		end  
	end  
	if player:FindFirstChild("Backpack") then  
		for _, item in ipairs(player.Backpack:GetChildren()) do  
			if item.Name == "Knife" then return "Murderer"  
			elseif item.Name == "Gun" or item.Name == "Revolver" then return "Sheriff" end  
		end  
	end  
	return "Innocent"
end

-- 1. Autofarm Tab
local isFarming = false
local farmSpeed = 35
local farmRadius = 200

Tabs.Farm:Section({ Title = "Coin Autofarm" })

Tabs.Farm:Toggle({
	Title = "Safe Coin Autofarm",
	Desc = "Automatically collects coins around the map using Tween.",
	Value = false,
	Callback = function(state)
		isFarming = state
		if state then
			WindUI:Notify({ Title = "Autofarm", Content = "Autofarm enabled!", Duration = 2, Icon = "check" })
			task.spawn(function()
				local touchedCoins = {}
				while isFarming do
					task.wait(0.3)
					pcall(function()
						local map = nil
						for _, v in workspace:GetDescendants() do
							if v:IsA("Model") and v.Name == "Base" then map = v.Parent break end
						end
						if map and LocalPlayer.Character then
							local coinContainer = map:FindFirstChild("CoinContainer")
							local root = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
							local humanoid = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
							
							if coinContainer and root and humanoid and humanoid.Health > 0 then
								local closestCoin = nil
								local shortestDist = farmRadius
								
								for _, desc in pairs(coinContainer:GetDescendants()) do
									if desc:IsA("TouchTransmitter") and desc.Parent and not touchedCoins[desc.Parent] then
										local coin = desc.Parent
										local dist = (root.Position - coin.Position).Magnitude
										if dist < shortestDist then
											shortestDist = dist
											closestCoin = coin
										end
									end
								end
								
								if closestCoin then
									local targetCFrame = closestCoin.CFrame + Vector3.new(0, 1, 0)
									local dist = (root.Position - closestCoin.Position).Magnitude
									local travelTime = math.clamp(dist / farmSpeed, 0.05, 1.2)
									
									local tweenInfo = TweenInfo.new(travelTime, Enum.EasingStyle.Linear)
									local tween = game:GetService("TweenService"):Create(root, tweenInfo, {CFrame = targetCFrame})
									tween:Play()
									tween.Completed:Wait()
									
									touchedCoins[closestCoin] = true
									task.wait(0.1)
								end
							end
						end
					end)
				end
			end)
		else
			WindUI:Notify({ Title = "Autofarm", Content = "Autofarm disabled.", Duration = 2, Icon = "power-off" })
		end
	end
})

