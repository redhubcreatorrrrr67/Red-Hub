Tabs.Combat:Section({ Title = "Quick Actions" })

local clickCounts = {
    ["Shoot Murderer"] = 0,
    ["Throw Knife"] = 0
}

local floatingButtons = {}

local function createFloatingButton(buttonName, action)
    if floatingButtons[buttonName] then
        return
    end

    local playerGui = LocalPlayer:WaitForChild("PlayerGui")

    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "RedHub" .. buttonName:gsub("%s+", "") .. "Button"
    screenGui.ResetOnSpawn = false
    screenGui.Parent = playerGui

    local button = Instance.new("TextButton")
    button.Name = "FloatingButton"
    button.Size = UDim2.fromOffset(170, 45)
    button.Position = UDim2.new(0.5, -85, 0.25, 0)
    button.BackgroundColor3 = Color3.fromRGB(100, 15, 15)
    button.TextColor3 = Color3.fromRGB(255, 255, 255)
    button.Text = "🩸 " .. buttonName
    button.TextSize = 15
    button.Font = Enum.Font.GothamBold
    button.Parent = screenGui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 12)
    corner.Parent = button

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(239, 68, 68)
    stroke.Thickness = 2
    stroke.Parent = button

    -- Drag support
    button.Active = true
    button.Draggable = true

    button.Activated:Connect(function()
        action()
    end)

    floatingButtons[buttonName] = screenGui
end

local function shootMurderer()
    pcall(function()
        local char = LocalPlayer.Character
        local gun = char and char:FindFirstChildOfClass("Tool")

        if gun and (gun.Name == "Gun" or gun.Name == "Revolver") then
            gun:Activate()
            WindUI:Notify({
                Title = "Combat",
                Content = "Gun activated!",
                Duration = 2,
                Icon = "check"
            })
        end
    end)
end

local function throwKnife()
    pcall(function()
        local char = LocalPlayer.Character
        local knife = char and char:FindFirstChildOfClass("Tool")

        if knife and knife.Name == "Knife" then
            knife:Activate()
            WindUI:Notify({
                Title = "Combat",
                Content = "Knife activated!",
                Duration = 2,
                Icon = "check"
            })
        end
    end)
end

